            android:targetPackage="com.cloudchat"
            android:targetClass="com.cloudchat.QuickActionActivity">
            <extra android:name="quick_action" android:value="send_voice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="send_text"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_text"
        android:shortcutShortLabel="@string/shortcut_send_text"
        android:shortcutLongLabel="@string/shortcut_send_text">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cloudchat"
            android:targetClass="com.cloudchat.QuickActionActivity">
