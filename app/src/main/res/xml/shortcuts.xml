<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="send_image"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_image"
        android:shortcutShortLabel="@string/shortcut_send_image"
        android:shortcutLongLabel="@string/shortcut_send_image">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.cloudchat"
            android:targetClass="com.cloudchat.QuickActionActivity">
            <extra android:name="quick_action" android:value="send_image" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="send_voice"
        android:enabled="true"
